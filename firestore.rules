rules_version = '2';

// Security rules for the "familie-opgaver" Firestore database.
//
// NOTE ON THE SECURITY MODEL:
// The app signs in with Firebase Anonymous Authentication, so every request
// carries an auth token. These rules require that token (request.auth != null),
// which blocks scripts that merely have the public config but never load the
// app. They also enforce:
//   • only the two known collections (`tasks`, `members`) are usable
//   • every document must match a strict shape (fields + types + size caps)
//   • everything else is denied
// This is NOT per-person identity (anonymous = any visitor who loads the app can
// get a token). True per-user access control would require a real sign-in method
// (e.g. email/password) tied to each family member.

service cloud.firestore {
  match /databases/{database}/documents {

    function memberNames() {
      return ['Jesper', 'Line', 'Anker', 'Edith'];
    }

    // --- tasks ---
    function isValidTask(data) {
      return data.keys().hasOnly(['label', 'emoji', 'assignedTo', 'done', 'due', 'time', 'alarm', 'repeat', 'rotation', 'points', 'money', 'ts'])
        && data.label is string && data.label.size() > 0 && data.label.size() <= 500
        && (!('emoji' in data) || data.emoji == null || (data.emoji is string && data.emoji.size() <= 16))
        && data.assignedTo in memberNames()
        && data.done is bool
        && (data.due == null || (data.due is string && data.due.size() <= 10))
        && (!('time' in data) || data.time == null || (data.time is string && data.time.size() <= 5))
        && (!('alarm' in data) || data.alarm is bool)
        && (!('repeat' in data) || data.repeat == null || data.repeat in ['daily', '2day', 'weekly', '2week'])
        // rotation: a recurring chore that alternates assignee; the current
        // assignee must always be one of the rotating members
        && (!('rotation' in data) || data.rotation == null
            || (data.rotation is list && data.rotation.size() >= 2 && data.rotation.size() <= 10
                && data.rotation.hasOnly(memberNames()) && data.assignedTo in data.rotation))
        && (!('points' in data) || data.points == null
            || (data.points is int && data.points >= 0 && data.points <= 100))
        // money: kr allowance value; whole kroner only
        && (!('money' in data) || data.money == null
            || (data.money is int && data.money >= 0 && data.money <= 1000))
        && data.ts is number;
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isValidTask(request.resource.data);
      allow delete: if request.auth != null;
    }

    // --- completions (one doc per task per day, id `taskId:date`) ---
    // The append-only-ish log behind the weekly points tally. Delete is allowed
    // so un-checking a task the same day can take its stars back.
    function isValidCompletion(data) {
      return data.keys().hasOnly(['name', 'date', 'label', 'emoji', 'points', 'money', 'ts'])
        && data.name in memberNames()
        && data.date is string && data.date.size() == 10
        && data.label is string && data.label.size() > 0 && data.label.size() <= 500
        && (!('emoji' in data) || data.emoji == null || (data.emoji is string && data.emoji.size() <= 16))
        && data.points is int && data.points >= 0 && data.points <= 100
        && (!('money' in data) || data.money == null
            || (data.money is int && data.money >= 0 && data.money <= 1000))
        && data.ts is number;
    }

    match /completions/{completionId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isValidCompletion(request.resource.data);
      allow delete: if request.auth != null;
    }

    // --- members (one doc per person: hashed PIN + chosen look) ---
    // `face` (an emoji) and `color` (hex) are the kid-mode "Vælg dit look"
    // customisation; all fields optional so a look can be saved before a PIN
    // exists and vice versa (writes use merge).
    function isValidMember(data) {
      return data.keys().hasOnly(['pinHash', 'face', 'color'])
        && (!('pinHash' in data) || data.pinHash == null
            || (data.pinHash is string && data.pinHash.size() <= 64))
        && (!('face' in data) || data.face == null
            || (data.face is string && data.face.size() > 0 && data.face.size() <= 16))
        && (!('color' in data) || data.color == null
            || (data.color is string && data.color.matches('^#[0-9A-Fa-f]{6}$')));
    }

    match /members/{name} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && name in memberNames()
        && isValidMember(request.resource.data);
      allow delete: if false;
    }

    // --- everything else: denied ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
